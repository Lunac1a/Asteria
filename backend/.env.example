APP_NAME='Asteria API'
APP_PORT=18001

FRONTEND_URL=http://localhost:3001
DATABASE_URL=postgresql+psycopg://asteria:local-development-only@127.0.0.1:55432/asteria_local

JWT_SECRET_KEY=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60


# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Prefer app/cli/local.py configure to generate isolated secrets.
# Configure personal OpenAI-compatible credentials in Settings.
LOCAL_DATA_DIR=../data/local-mvp
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LLM_BACKEND=provider
# Only true for a clearly identified synthetic loopback provider during tests.
PROVIDER_IS_SIMULATED=false
LLM_ALLOWED_BASE_URLS=https://integrate.api.nvidia.com/v1
# For the existing local Sub2API gateway, explicitly allow its exact API root:
# LLM_ALLOWED_BASE_URLS=https://integrate.api.nvidia.com/v1,http://127.0.0.1:18080/v1
RETRIEVAL_MIN_SCORE=0.35
MAX_UPLOAD_BYTES=10485760
MAX_WORKSPACE_CHUNKS=2000
INDEX_TIMEOUT_SECONDS=90
QUERY_TIMEOUT_SECONDS=30

# Only enable pairs verified against this endpoint with a strict-schema capability probe.
# Unknown providers keep constrained parsing; no automatic downgrade or retry.
# JSON example: [{"base_url":"https://verified-provider.example/v1","model":"verified-model"}]
GENERATION_JSON_SCHEMA_PROFILES=[]

# Enable only after reviewing provider-specific faithfulness evaluation and cost.
CITATION_AUDIT_ENABLED=false
CITATION_AUDIT_TIMEOUT_SECONDS=18

# Content-free local JSONL only; 2 MB per file, 3 rotated backups. No remote analytics.
RUNTIME_METRICS_ENABLED=true
