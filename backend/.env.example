APP_NAME='Asteria API'
APP_HOST=127.0.0.1
APP_PORT=18001

FRONTEND_URL=http://localhost:3001
DATABASE_URL=postgresql+psycopg://asteria:local-development-only@127.0.0.1:55432/asteria_local

JWT_SECRET_KEY=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Prefer scripts/local.py configure to generate isolated secrets.
# Global NVIDIA_* values are optional; configure personal credentials in Settings.
LOCAL_DATA_DIR=../data/local-mvp
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LLM_BACKEND=provider
LLM_ALLOWED_BASE_URLS=https://integrate.api.nvidia.com/v1
RETRIEVAL_MIN_SCORE=0.45
MAX_UPLOAD_BYTES=10485760
MAX_WORKSPACE_CHUNKS=2000
INDEX_TIMEOUT_SECONDS=90
QUERY_TIMEOUT_SECONDS=30
